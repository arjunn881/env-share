---
export interface Props {
  title: string;
  description: string;
  canonical?: string;
  ogImage?: string;
  noindex?: boolean;
  keywords?: string;
  faqSchema?: Array<{ q: string; a: string }>;
  pageType?: 'WebPage' | 'TechArticle' | 'FAQPage' | 'CollectionPage';
}

const {
  title,
  description,
  canonical = `https://env.json2x.com${Astro.url.pathname.replace(/\/$/, '') || '/'}`,
  ogImage = 'https://env.json2x.com/og/default.png',
  noindex = false,
  keywords = '.env file sharing, dotenv sharing, share .env securely, env file share, dot env share, share environment variables, encrypted dotenv sharing, secure .env transfer, npx share-env, share-env cli',
  faqSchema,
  pageType = 'WebPage',
} = Astro.props;

const SITE_NAME = 'share-env';
const fullTitle = title.includes(SITE_NAME) ? title : `${title} | ${SITE_NAME}`;

// Breadcrumb path parser
const pathParts = Astro.url.pathname.replace(/\/$/, '').split('/').filter(Boolean);
const breadcrumbs = [
  { name: 'Home', url: 'https://env.json2x.com' },
  ...pathParts.map((part, i) => ({
    name: part.replace(/-/g, ' ').replace(/\b\w/g, c => c.toUpperCase()),
    url: `https://env.json2x.com/${pathParts.slice(0, i + 1).join('/')}`,
  })),
];

// Schemas
const websiteSchema = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  name: 'share-env',
  url: 'https://env.json2x.com',
  description: 'Secure .env file sharing for developers using AES-256-GCM encryption. Share dotenv files safely without Slack or email.',
  potentialAction: {
    '@type': 'SearchAction',
    target: { '@type': 'EntryPoint', urlTemplate: 'https://env.json2x.com/blog?q={search_term_string}' },
    'query-input': 'required name=search_term_string',
  },
};

const orgSchema = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  name: 'share-env',
  url: 'https://env.json2x.com',
  logo: 'https://env.json2x.com/favicon.svg',
  sameAs: [
    'https://github.com/arjunn881/env-share',
    'https://www.npmjs.com/package/share-env',
  ],
};

const softwareSchema = {
  '@context': 'https://schema.org',
  '@type': 'SoftwareApplication',
  name: 'share-env',
  alternateName: ['env-share', 'share env', 'dotenv share', '.env share', 'share dotenv'],
  applicationCategory: 'DeveloperApplication',
  applicationSubCategory: 'Security Tool',
  operatingSystem: 'Windows, macOS, Linux',
  url: 'https://env.json2x.com',
  downloadUrl: 'https://www.npmjs.com/package/share-env',
  installUrl: 'https://www.npmjs.com/package/share-env',
  softwareVersion: '1.0.9',
  softwareRequirements: 'Node.js 18+',
  license: 'https://opensource.org/licenses/MIT',
  description: 'CLI tool to share .env files securely using AES-256-GCM encryption and a zero-knowledge relay server. No accounts required — run via npx.',
  featureList: [
    'AES-256-GCM end-to-end encryption',
    'Burn-after-reading — payload deleted on first pull',
    'Zero-knowledge relay server',
    '10-minute TTL auto-expiry',
    'Smart merge for conflict resolution',
    'Git guardrail — blocks if .env not in .gitignore',
    'No account or configuration required',
    'Self-hostable relay server',
  ],
  offers: { '@type': 'Offer', price: '0', priceCurrency: 'USD' },
};

const breadcrumbSchema = breadcrumbs.length > 1 ? {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: breadcrumbs.map((b, i) => ({
    '@type': 'ListItem',
    position: i + 1,
    name: b.name,
    item: b.url,
  })),
} : null;

const faqPageSchema = faqSchema && faqSchema.length > 0 ? {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqSchema.map(({ q, a }) => ({
    '@type': 'Question',
    name: q,
    acceptedAnswer: { '@type': 'Answer', text: a },
  })),
} : null;
---

<!DOCTYPE html>
<html lang="en" prefix="og: https://ogp.me/ns#">
<head>
  <meta charset="UTF-8" />
