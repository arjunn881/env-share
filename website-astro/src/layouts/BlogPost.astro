---
import Base from './Base.astro';
import AdSlot from '../components/AdSlot.astro';

const { frontmatter } = Astro.props;
const { title, description, date, readTime, tags } = frontmatter;
const formattedDate = new Date(date).toLocaleDateString('en-US', { month: 'long', day: 'numeric', year: 'numeric' });
---

<Base title={title} description={description}>
  <div class="container">
    <div style="max-width:740px;margin:0 auto;">
      <div class="page-hero" style="margin-bottom:40px;">
        <div style="display:flex;flex-wrap:wrap;gap:6px;margin-bottom:16px;">
          {tags.map((tag: string) => (
            <span style="background:rgba(61,255,176,.06);border:1px solid var(--border);color:var(--accent);font-size:.62rem;font-weight:700;padding:2px 8px;border-radius:100px;letter-spacing:.5px;text-transform:uppercase;">{tag}</span>
          ))}
        </div>
        <h1 style="font-size:clamp(1.8rem,3.5vw,2.6rem);letter-spacing:-1.4px;">{title}</h1>
        <div style="display:flex;align-items:center;gap:12px;margin-top:14px;font-size:.78rem;color:var(--text-dim);">
          <time datetime={date}>{formattedDate}</time>
          <span>&middot;</span>
          <span>{readTime}</span>
        </div>
      </div>

      <!-- Top Ad -->
      <AdSlot slot={undefined} />

      <!-- Article content -->
      <article class="prose">
        <slot />
      </article>

      <!-- Bottom Ad -->
      <div style="margin-top:48px;">
        <AdSlot slot={undefined} />
      </div>

      <!-- Nav links -->
      <div style="margin-top:48px;padding-top:32px;border-top:1px solid var(--border);display:flex;justify-content:space-between;align-items:center;flex-wrap:wrap;gap:16px;">
        <a href="/blog" style="display:flex;align-items:center;gap:8px;font-size:.85rem;color:var(--text-muted);transition:color .2s;" class="back-link">
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="15 18 9 12 15 6"/></svg>
          All articles
        </a>
        <a href="/" style="font-size:.85rem;color:var(--text-muted);transition:color .2s;" class="back-link">Try share-env &rarr;</a>
      </div>
    </div>
  </div>
</Base>

<style is:global>
.prose { line-height: 1.75; font-size: .96rem; color: var(--text-muted); }
.prose h2 { font-size: 1.25rem; font-weight: 800; color: var(--text); letter-spacing: -.6px; margin: 40px 0 14px; padding-bottom: 10px; border-bottom: 1px solid var(--border); }
.prose h3 { font-size: 1rem; font-weight: 700; color: var(--text); margin: 28px 0 10px; }
.prose p { margin: 0 0 16px; }
.prose ul, .prose ol { margin: 0 0 16px 0; padding-left: 24px; display: flex; flex-direction: column; gap: 6px; }
.prose li { color: var(--text-muted); }
.prose li::marker { color: var(--accent); }
.prose a { color: var(--accent); text-decoration: underline; text-underline-offset: 3px; }
.prose a:hover { opacity: .8; }
.prose strong { color: var(--text); font-weight: 600; }
.prose code { font-family: 'JetBrains Mono', monospace; font-size: .85em; color: var(--accent); background: rgba(61,255,176,0.07); padding: 2px 6px; border-radius: 4px; }
.prose pre { background: #040710; border: 1px solid rgba(61,255,176,0.18); border-radius: 12px; padding: 18px 22px; overflow-x: auto; margin: 0 0 20px; }
.prose pre code { background: none; padding: 0; font-size: .78rem; color: var(--text-muted); }
.prose blockquote { border-left: 3px solid var(--accent); padding: 12px 16px; background: rgba(61,255,176,0.03); border-radius: 0 8px 8px 0; margin: 0 0 16px; }
.prose hr { border: none; border-top: 1px solid var(--border); margin: 36px 0; }
.prose table { width: 100%; border-collapse: collapse; margin: 0 0 20px; font-size: .86rem; }
.prose th { text-align: left; padding: 9px 14px; border-bottom: 1px solid var(--border); font-size: .7rem; font-weight: 700; letter-spacing: .5px; text-transform: uppercase; color: var(--text-dim); }
.prose td { padding: 10px 14px; border-bottom: 1px solid rgba(61,255,176,0.04); color: var(--text-muted); }
.back-link:hover { color: var(--accent); }
</style>
