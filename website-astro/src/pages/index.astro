---
import Base from '../layouts/Base.astro';
import AdSlot from '../components/AdSlot.astro';

const homeFaq = [
  { q: 'What is share-env and how does it work?', a: 'share-env is a free CLI tool for securely sharing .env files (dotenv files) using AES-256-GCM encryption. Run npx share-env push to encrypt and upload your .env to a zero-knowledge relay. Share the one-time code with your teammate. They run npx share-env pull <code> to decrypt it locally. The payload self-destructs after one pull.' },
  { q: 'Is it safe to share .env files on Slack?', a: 'No. Sharing .env files on Slack exposes them to permanent message logs searchable by admins, potential workspace breaches, and third-party bot access. Use share-env instead — it encrypts your dotenv file before upload, and the relay server never sees the decryption key.' },
  { q: 'How do I share a .env file securely with my team?', a: 'Run npx share-env push in your project directory. Send the generated share code via any channel. Your teammate runs npx share-env pull <code>. The .env is decrypted locally — the relay server only ever stored unreadable ciphertext.' },
  { q: 'Does share-env work without installing anything?', a: 'Yes. Run share-env directly with npx — no global install needed. Requires only Node.js 18+.' },
];
---

<Base
  title="share-env — Secure .env File Sharing for Developers | Encrypted dotenv Transfer"
  description="Share .env files securely with your team. AES-256-GCM encrypted, burn-after-reading, zero accounts. Run npx share-env push/pull. The safest way to share dotenv files."
  keywords=".env file sharing, dotenv sharing, share .env securely, dot env share, share dotenv file, .env share, env file share, safely share .env, share dot env file, encrypted .env sharing, npx share-env, share-env cli, secure dotenv transfer, .env file transfer tool, share environment variables"
  faqSchema={homeFaq}
>
  <!-- HERO -->
  <section id="hero" style="min-height:100vh;display:flex;align-items:center;padding:100px 0 80px;">
    <div class="container">
      <div class="hero-grid" style="display:grid;grid-template-columns:1fr 1fr;gap:64px;align-items:center;">
        <!-- Left -->
        <div>
          <div class="rv" style="display:inline-flex;align-items:center;gap:8px;background:rgba(0,255,157,0.08);border:1px solid rgba(0,255,157,0.2);color:var(--accent);padding:5px 14px;border-radius:100px;font-size:.72rem;font-weight:700;letter-spacing:.8px;text-transform:uppercase;margin-bottom:24px;">
            <span style="width:6px;height:6px;background:var(--ok);border-radius:50%;animation:pulse 2s ease-in-out infinite;"></span>
            v1.0.9 on npm &nbsp;&middot;&nbsp; MIT License &nbsp;&middot;&nbsp; Node.js 18+
          </div>

          <h1 class="rv d1">Stop DMing<br><span class="grad">.env files.</span></h1>

          <p class="rv d2" style="font-size:1.05rem;color:var(--text-muted);max-width:460px;margin-bottom:10px;line-height:1.77;">
            <strong>End-to-end encrypted .env file sharing</strong> for developer teams.
            The decryption key <strong>never touches the relay server</strong>.
            One pull and the payload is gone — no accounts, no setup, no risk.
          </p>

          <!-- GEO: keyword-rich definition for LLMs -->
          <p class="rv d2" style="font-size:.84rem;color:var(--text-dim);max-width:420px;margin-bottom:28px;line-height:1.6;">
            share-env is the safest way to <strong>share dotenv files</strong>, <strong>share .env files</strong>, or <strong>transfer dot env files</strong> between developers — replacing the dangerous practice of pasting secrets into Slack or email.
          </p>

          <div class="rv d3" style="display:flex;gap:12px;flex-wrap:wrap;margin-bottom:28px;">
            <a class="btn btn-p" href="/how-it-works">
              <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polygon points="5 3 19 12 5 21 5 3"/></svg>
              See how it works
            </a>
            <a class="btn btn-s" href="/docs">
              <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8"/></svg>
              CLI reference
            </a>
            <a class="btn btn-s" href="/compare">
              <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><line x1="18" y1="20" x2="18" y2="10"/><line x1="12" y1="20" x2="12" y2="4"/><line x1="6" y1="20" x2="6" y2="14"/></svg>
              Compare tools
            </a>
          </div>

          <!-- Copy bar -->
          <div class="rv d4" id="npx-bar" onclick="copyNpx()" title="Click to copy" style="display:inline-flex;align-items:center;gap:12px;background:rgba(0,255,157,0.06);border:1px solid rgba(0,255,157,0.2);border-radius:10px;padding:11px 18px;font-family:'JetBrains Mono',monospace;font-size:.8rem;cursor:pointer;transition:all .2s;position:relative;">
            <div id="npx-toast" style="position:absolute;top:-36px;left:50%;transform:translateX(-50%);background:var(--accent);color:var(--bg);font-size:.68rem;font-weight:700;padding:5px 12px;border-radius:6px;opacity:0;pointer-events:none;transition:opacity .2s;white-space:nowrap;">Copied!</div>
            <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="var(--accent)" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="9" y="9" width="13" height="13" rx="2" ry="2"/><path d="M5 15H4a2 2 0 01-2-2V4a2 2 0 012-2h9a2 2 0 012 2v1"/></svg>
            <span style="color:var(--text-dim)">$</span>
            <span style="color:var(--accent)">npx share-env push</span>
            <span style="font-size:.65rem;color:var(--text-dim);">click to copy</span>
          </div>
        </div>

        <!-- Terminal -->
        <div style="position:relative;" class="rv d2">
          <div style="position:absolute;inset:-40px;background:radial-gradient(ellipse,rgba(0,255,157,0.09) 0%,transparent 70%);pointer-events:none;"></div>
          <div style="background:#020710;border:1px solid rgba(0,255,157,0.22);border-radius:24px;overflow:hidden;box-shadow:0 48px 96px rgba(0,0,0,.7),0 0 0 1px rgba(0,255,157,0.06);">
            <div style="background:rgba(0,255,157,0.04);padding:13px 18px;display:flex;align-items:center;gap:10px;border-bottom:1px solid rgba(0,255,157,0.1);">
              <div style="display:flex;gap:6px;">
                <span style="width:10px;height:10px;border-radius:50%;background:#ff5f57;"></span>
                <span style="width:10px;height:10px;border-radius:50%;background:#ffbd2e;"></span>
                <span style="width:10px;height:10px;border-radius:50%;background:#28c840;"></span>
              </div>
              <span style="flex:1;text-align:center;font-size:.68rem;color:var(--text-dim);font-family:'JetBrains Mono',monospace;">zsh — ~/projects/my-app — share-env</span>
            </div>
            <div id="term-body" style="padding:22px 24px;font-family:'JetBrains Mono',monospace;font-size:.77rem;line-height:1.85;min-height:300px;" aria-label="Terminal demo" role="region"></div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- STATS -->
  <div class="sec-divider"></div>
  <section style="padding:48px 0;" aria-label="Key statistics">
    <div class="container">
      <div style="display:grid;grid-template-columns:repeat(4,1fr);gap:1px;background:var(--border);" role="list">
        {[
          { num:'AES-256', label:'GCM authenticated encryption' },
          { num:'0', label:'accounts, config or API keys needed' },
          { num:'10m', label:'TTL — auto-deleted if uncollected' },
          { num:'1×', label:'pull only — burned after reading' },
        ].map((s,i) => (
          <div class="stat-card rv" style={`transition-delay:${i*.07}s;`} role="listitem">
            <div class="stat-num">{s.num}</div>
            <div class="stat-label">{s.label}</div>
          </div>
        ))}
      </div>
    </div>
  </section>
  <div class="sec-divider"></div>

  <!-- AD SLOT -->
  <div class="container">
    <AdSlot slot={undefined} />
  </div>

  <!-- PROBLEM / SOLUTION -->
  <section aria-labelledby="problem-heading">
    <div class="container">
      <div class="sh">
        <p class="sl rv">The Problem</p>
        <h2 id="problem-heading" class="st rv d1">Your secrets deserve better than a Slack message.</h2>
        <p class="ss rv d2">Every day, developers <strong>share .env files</strong> via chat, email, and shared docs. Those secrets live in logs and history forever. This is the single biggest source of accidental secret exposure in development teams.</p>
      </div>
      <div style="display:grid;grid-template-columns:1fr 1fr;gap:20px;" class="cmp-g">
        <!-- Danger -->
        <div style="border-radius:20px;padding:32px;border:1px solid rgba(244,63,94,.18);background:rgba(244,63,94,.03);" class="rv">
          <div style="display:flex;align-items:center;gap:12px;margin-bottom:18px;">
            <div style="width:38px;height:38px;border-radius:9px;background:rgba(244,63,94,.12);color:var(--danger);display:flex;align-items:center;justify-content:center;">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="10"/><line x1="15" y1="9" x2="9" y2="15"/><line x1="9" y1="9" x2="15" y2="15"/></svg>
            </div>
            <strong style="font-size:.93rem;">The dangerous way (what most teams do)</strong>
          </div>
          <ul style="list-style:none;display:flex;flex-direction:column;gap:10px;">
            {[
              'Paste .env file contents into Slack / Discord',
              'Email the dotenv file as an attachment',
              'Share a Google Doc with API keys visible',
              'Commit .env to git "just this once"',
              'Screenshot the env file and send it',
            ].map(item => (
              <li style="font-size:.855rem;color:var(--text-muted);display:flex;gap:10px;align-items:flex-start;line-height:1.55;">
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="var(--danger)" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" style="flex-shrink:0;margin-top:2px;" aria-hidden="true"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>
                {item}
              </li>
            ))}
          </ul>
        </div>
        <!-- Safe -->
        <div style="border-radius:20px;padding:32px;border:1px solid rgba(0,255,157,.18);background:rgba(0,255,157,.025);" class="rv d1">
          <div style="display:flex;align-items:center;gap:12px;margin-bottom:18px;">
            <div style="width:38px;height:38px;border-radius:9px;background:rgba(0,255,157,.1);color:var(--accent);display:flex;align-items:center;justify-content:center;">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/><polyline points="9 12 11 14 15 10"/></svg>
            </div>
            <strong style="font-size:.93rem;">share-env — secure .env file sharing</strong>
          </div>
          <ul style="list-style:none;display:flex;flex-direction:column;gap:10px;">
            {[
              'AES-256-GCM encrypted before leaving your machine',
              'Relay server sees only ciphertext — never the key',
              'Payload deleted on first pull (burn-after-reading)',
              'Auto-expires after 10 minutes if uncollected',
              'Blocks the tool if .gitignore does not cover .env',
            ].map(item => (
              <li style="font-size:.855rem;color:var(--text-muted);display:flex;gap:10px;align-items:flex-start;line-height:1.55;">
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="var(--accent)" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" style="flex-shrink:0;margin-top:2px;" aria-hidden="true"><polyline points="20 6 9 17 4 12"/></svg>
                {item}
              </li>
            ))}
          </ul>
        </div>
      </div>
    </div>
  </section>

  <!-- HOW IT WORKS (condensed) -->
  <section style="background:linear-gradient(180deg,rgba(0,255,157,0.02) 0%,transparent 100%);padding:80px 0;" aria-labelledby="hiw-heading">
    <div class="container">
      <div class="sh">
        <p class="sl rv">How it works</p>
        <h2 id="hiw-heading" class="st rv d1">Three steps. <span class="grad">Ten seconds.</span></h2>
      </div>
      <div style="display:grid;grid-template-columns:repeat(3,1fr);gap:16px;" class="steps-g">
        {[
          { n:'01', title:'Push', desc:'Run npx share-env push. Your .env file is encrypted with AES-256-GCM locally. Only ciphertext goes to the relay.', code:'$ npx share-env push', color:'var(--accent)' },
          { n:'02', title:'Share the code', desc:'Send the one-time share code (phrase#key) via Slack, Signal, or email. The code is useless without the key portion.', code:'apple-brave-cloud#a3f9b2...', color:'var(--accent-2)' },
          { n:'03', title:'Pull', desc:'Your teammate runs npx share-env pull <code>. The .env is decrypted locally. The payload is permanently deleted.', code:'$ npx share-env pull <code>', color:'var(--accent-3)' },
        ].map((s,i) => (
          <div class={`rv hover-card${i > 0 ? ` d${i}` : ''}`} style="background:var(--bg-card);border:1px solid var(--border);border-radius:20px;padding:28px 24px;backdrop-filter:blur(16px);">
            <div style={`font-family:'JetBrains Mono',monospace;font-size:2rem;font-weight:900;color:${s.color};opacity:.25;margin-bottom:12px;line-height:1;`}>{s.n}</div>
            <h3 style="font-weight:800;font-size:1rem;margin-bottom:8px;">{s.title}</h3>
            <p style="font-size:.855rem;color:var(--text-muted);line-height:1.65;margin-bottom:14px;">{s.desc}</p>
            <code style={`color:${s.color};font-size:.75rem;`}>{s.code}</code>
          </div>
        ))}
      </div>
      <div class="rv d3" style="text-align:center;margin-top:32px;">
        <a href="/how-it-works" class="btn btn-s">Full flow explanation &rarr;</a>
      </div>
    </div>
  </section>

  <div class="container"><AdSlot slot={undefined} /></div>

  <!-- E-E-A-T / TRUST SIGNALS -->
  <section aria-labelledby="trust-heading">
    <div class="container">
      <div class="sh">
        <p class="sl rv">Trust & Security</p>
        <h2 id="trust-heading" class="st rv d1">Built to be auditable.</h2>
        <p class="ss rv d2">Every line of the encryption logic is public. You can verify share-env does exactly what it claims.</p>
      </div>
      <div style="display:grid;grid-template-columns:repeat(3,1fr);gap:16px;" class="trust-g">
        {[
          { icon:'M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z', title:'Verified encryption', desc:'AES-256-GCM is implemented using Node.js\'s built-in crypto module — no third-party encryption library. Source is public and auditable.', c:'var(--accent)' },
          { icon:'M9 19c-5 1.5-5-2.5-7-3m14 6v-3.87a3.37 3.37 0 00-.94-2.61c3.14-.35 6.44-1.54 6.44-7A5.44 5.44 0 0020 4.77A5.07 5.07 0 0019.91 1S18.73.65 16 2.48a13.38 13.38 0 00-7 0C6.27.65 5.09 1 5.09 1A5.07 5.07 0 005 4.77a5.44 5.44 0 00-1.5 3.78c0 5.42 3.3 6.61 6.44 7A3.37 3.37 0 009 18.13V22', title:'Open source (MIT)', desc:'The entire codebase is MIT licensed and publicly available on GitHub. Fork it, audit it, self-host it. No black boxes.', c:'var(--accent-2)' },
          { icon:'M3 9l9-7 9 7v11a2 2 0 01-2 2H5a2 2 0 01-2-2z', title:'Self-hostable relay', desc:'Run your own relay server on any Node.js host. The CLI\'s --server flag lets you point to any URL. Complete control.', c:'var(--accent-3)' },
          { icon:'M21 16V8a2 2 0 00-1-1.73l-7-4a2 2 0 00-2 0l-7 4A2 2 0 003 8v8a2 2 0 001 1.73l7 4a2 2 0 002 0l7-4A2 2 0 0021 16z', title:'Zero-knowledge design', desc:'The relay server stores only ciphertext. The 256-bit AES key travels exclusively in your share code — not through the relay.', c:'var(--accent)' },
          { icon:'M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z', title:'Git guardrail (mandatory)', desc:'share-env refuses to run if your .gitignore does not cover .env. The guardrail cannot be disabled or bypassed.', c:'var(--ok)' },
          { icon:'M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z', title:'No data retention', desc:'Payloads are stored in relay memory only. No database, no logs, no persistence beyond the 10-minute TTL.', c:'var(--accent-2)' },
        ].map(f => (
          <div class="grad-card rv hover-card" style="padding:26px 22px;">
            <div style={`width:40px;height:40px;border-radius:10px;background:rgba(0,255,157,0.07);border:1px solid rgba(0,255,157,0.15);color:${f.c};display:flex;align-items:center;justify-content:center;margin-bottom:14px;`}>
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d={f.icon}/></svg>
            </div>
            <h3 style="font-weight:700;font-size:.93rem;margin-bottom:8px;">{f.title}</h3>
            <p style="font-size:.845rem;color:var(--text-muted);line-height:1.65;">{f.desc}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- FAQ SECTION (AEO / featured snippets) -->
  <section style="background:linear-gradient(180deg,rgba(0,255,157,0.015) 0%,transparent 100%);" aria-labelledby="faq-heading">
    <div class="container">
      <div class="sh">
        <p class="sl rv">Common Questions</p>
        <h2 id="faq-heading" class="st rv d1">Questions about <span class="grad">.env file sharing.</span></h2>
      </div>
      <div style="display:flex;flex-direction:column;gap:10px;max-width:860px;" class="rv">
        {homeFaq.map((faq, i) => (
          <div class="answer-box" itemscope itemtype="https://schema.org/Question">
            <div class="ab-q" itemprop="name">{faq.q}</div>
            <div class="ab-a" itemprop="acceptedAnswer" itemscope itemtype="https://schema.org/Answer">
              <span itemprop="text">{faq.a}</span>
            </div>
          </div>
        ))}
      </div>
      <div class="rv d2" style="margin-top:24px;">
        <a href="/faq" class="btn btn-s">See all 20 FAQ answers &rarr;</a>
      </div>
    </div>
  </section>

  <!-- KEYWORD COVERAGE (programmatic SEO) -->
  <section style="padding:48px 0;" aria-label="Related topics">
    <div class="container">
      <div style="border:1px solid var(--border);border-radius:var(--r-lg);padding:28px 32px;background:var(--bg-card);backdrop-filter:blur(14px);" class="rv">
        <div style="font-size:.78rem;font-weight:700;color:var(--text-dim);letter-spacing:1px;text-transform:uppercase;margin-bottom:14px;">Related searches &amp; topics</div>
        <div style="display:flex;flex-wrap:wrap;gap:6px;" aria-label="Related keyword topics">
          {['.env','dotenv','dot env','share env','env share','.env file sharing','share .env','share dot env','.env share','dot env file share','share dot env file','safely share dot env file','.env file share safely','secure .env sharing','encrypted dotenv','share environment variables','npx share-env','share-env npm','dotenv encryption','AES-256-GCM dotenv','.env security','dotenv best practices','env file transfer','share .env without slack','.env nodejs','.env nextjs','.env react','.env docker','dotenv npm package','env file collaboration','zero knowledge .env','burn after reading env','one-time .env share','ephemeral env sharing','self host relay server','dotenv merge','env conflict resolution','.env gitignore','secure secret sharing cli','developer secret sharing'].map(kw => (
            <a href={`/faq`} class="kw-pill" aria-label={`Learn about ${kw}`}>{kw}</a>
          ))}
        </div>
      </div>
    </div>
  </section>

  <div class="container"><AdSlot slot={undefined} /></div>

  <!-- CTA -->
  <section style="padding:80px 0;text-align:center;" aria-labelledby="cta-heading">
    <div class="container">
      <p class="sl rv" style="justify-content:center;">Get started now</p>
      <h2 id="cta-heading" class="st rv d1" style="max-width:500px;margin:0 auto 14px;">One command to share your <span class="grad">.env</span> safely.</h2>
      <p class="rv d2 ss" style="margin:0 auto 28px;text-align:center;">No install. No account. No risk. Works anywhere Node.js 18+ is available.</p>
      <div class="rv d3" style="margin-bottom:20px;">
        <div class="cblock" style="display:inline-block;min-width:420px;">
          <div class="cblock-head"><span class="cblock-lang">bash</span><button class="cbtn" onclick="cb(this,'npx share-env push')"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" width="11" height="11"><rect x="9" y="9" width="13" height="13" rx="2" ry="2"/><path d="M5 15H4a2 2 0 01-2-2V4a2 2 0 012-2h9a2 2 0 012 2v1"/></svg>Copy</button></div>
          <pre class="ccode"><span style="color:rgba(0,255,157,0.5);">$</span> <span style="color:var(--accent);">npx share-env push</span></pre>
        </div>
      </div>
      <div class="rv d4" style="display:flex;gap:12px;justify-content:center;flex-wrap:wrap;">
        <a href="/docs" class="btn btn-p">Read the docs &rarr;</a>
        <a href="/security" class="btn btn-s">Security model</a>
        <a href="/compare" class="btn btn-s">Compare tools</a>
      </div>
    </div>
  </section>

  <style>
    @keyframes pulse { 0%,100%{opacity:1;transform:scale(1)} 50%{opacity:.5;transform:scale(.82)} }
    @keyframes bl { 0%,100%{opacity:1} 50%{opacity:0} }
    @media(max-width:960px){
      .hero-grid{grid-template-columns:1fr!important;gap:36px!important}
      .cmp-g{grid-template-columns:1fr!important}
      .steps-g{grid-template-columns:1fr 1fr!important}
      .trust-g{grid-template-columns:1fr 1fr!important}
      [style*="grid-template-columns:repeat(4"]{grid-template-columns:1fr 1fr!important}
    }
    @media(max-width:640px){
      #hero{padding:80px 0 56px!important}
      .steps-g,.trust-g{grid-template-columns:1fr!important}
    }
  </style>

  <script>
    const termLines = [
      {t:'cmd',s:'npx share-env push'},
      {t:'o',s:'  Checking .gitignore...'},
      {t:'ok',s:'  .env is protected — good.'},
      {t:'o',s:'  3 key(s) loaded from .env'},
      {t:'o',s:'  Generating AES-256-GCM key...'},
      {t:'o',s:'  Encrypting .env locally...'},
      {t:'o',s:'  Uploading ciphertext to relay...'},
      {t:'ok',s:'  Payload uploaded. Your share code:'},
      {t:'box',s:'  apple-brave-cloud#a3f9b2c1d4e5...'},
      {t:'w',s:'  Expires in 10m. One-time use.'},
      {t:'gap',s:''},
      {t:'cmd',s:'npx share-env pull apple-brave-cloud#...'},
      {t:'o',s:'  Checking .gitignore...'},
      {t:'o',s:'  Fetching encrypted payload...'},
      {t:'o',s:'  Decrypting locally (AES-256-GCM)...'},
      {t:'ok',s:'  Done!  .env written to: /project/.env'},
      {t:'cur',s:''},
    ];
    let li=0;
    const tb=document.getElementById('term-body');
    function addLine(l){
      const el=document.createElement('div');
      if(l.t==='cmd') el.innerHTML='<span style="color:rgba(0,255,157,.5)">$</span><span style="color:#e2eeff"> '+l.s+'</span>';
      else if(l.t==='ok') { el.style.color='var(--ok)'; el.style.paddingLeft='18px'; el.textContent=l.s; }
      else if(l.t==='w') { el.style.color='var(--warn)'; el.style.paddingLeft='18px'; el.textContent=l.s; }
      else if(l.t==='box') { el.style.cssText='border:1px solid rgba(0,255,157,.2);border-radius:6px;padding:8px 14px;margin:4px 0 6px 18px;color:var(--accent);font-size:.74rem;background:rgba(0,255,157,0.04);'; el.textContent=l.s; }
      else if(l.t==='gap') el.style.marginTop='10px';
      else if(l.t==='cur') el.innerHTML='<span style="color:rgba(0,255,157,.5)">$</span><span style="display:inline-block;width:7px;height:13px;background:var(--accent);animation:bl 1.1s step-end infinite;vertical-align:middle;margin-left:4px;border-radius:1px;"></span>';
      else { el.style.color='var(--text-muted)'; el.style.paddingLeft='18px'; el.textContent=l.s; }
      tb && (tb.appendChild(el), tb.scrollTop=tb.scrollHeight);
    }
    function runTerm(){ if(li>=termLines.length)return; addLine(termLines[li++]); const d=termLines[li-1].t==='cmd'?500:termLines[li-1].t==='gap'?350:115; setTimeout(runTerm,d); }
    const ho=new IntersectionObserver(es=>es.forEach(e=>{
      if(e.isIntersecting){ tb.innerHTML=''; li=0; setTimeout(runTerm,800); ho.unobserve(e.target); }
    }),{threshold:.2});
    const hero=document.getElementById('hero');
    if(hero) ho.observe(hero);

    function copyNpx(){
      navigator.clipboard.writeText('npx share-env push').then(()=>{
        const t=document.getElementById('npx-toast');
        if(t){ t.style.opacity='1'; setTimeout(()=>t.style.opacity='0',2000); }
      });
    }
  </script>
</Base>
