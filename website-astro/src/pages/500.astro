---
import Base from '../layouts/Base.astro';
---

<Base
  title="500 — Internal Server Error"
  description="Something went wrong on the server. Your local .env files are safe. Try reloading or check our status."
  noindex={true}
>
  <div class="container" style="min-height: calc(100vh - var(--nav-h) - 300px); display: flex; flex-direction: column; justify-content: center; padding-top: 60px; padding-bottom: 80px;">
    
    <div style="max-width: 760px; margin: 0 auto; width: 100%; text-align: center;">
      
      <!-- Status pill -->
      <div style="display: inline-flex; align-items: center; gap: 8px; background: rgba(245,158,11,0.1); border: 1px solid rgba(245,158,11,0.25); color: var(--warn); padding: 5px 14px; border-radius: 100px; font-size: .75rem; font-weight: 700; letter-spacing: 1px; text-transform: uppercase; margin-bottom: 24px;">
        <span style="width: 7px; height: 7px; background: var(--warn); border-radius: 50%; animation: pulse 2s infinite;"></span>
        HTTP 500 &nbsp;&middot;&nbsp; Server Issue Detected
      </div>

      <h1 style="font-size: clamp(3rem, 7vw, 5.5rem); font-weight: 900; line-height: 1; letter-spacing: -3px; margin-bottom: 16px;">
        500 <span class="grad">Server Error</span>
      </h1>

      <p style="font-size: 1.1rem; color: var(--text-muted); max-width: 520px; margin: 0 auto 36px; line-height: 1.7;">
        An unexpected error occurred on the server. Don't worry — your local <code style="color:var(--accent);">.env</code> secrets never left your machine unencrypted.
      </p>

      <!-- Terminal Mockup -->
      <div style="text-align: left; background: #020710; border: 1px solid rgba(245,158,11,0.3); border-radius: var(--r-lg); overflow: hidden; box-shadow: 0 24px 64px rgba(0,0,0,0.6); margin-bottom: 48px;">
        <div style="background: rgba(255,255,255,0.03); padding: 11px 16px; display: flex; align-items: center; justify-content: space-between; border-bottom: 1px solid var(--border);">
          <div style="display: flex; gap: 6px;">
            <span style="width: 10px; height: 10px; border-radius: 50%; background: #ff5f57;"></span>
            <span style="width: 10px; height: 10px; border-radius: 50%; background: #ffbd2e;"></span>
            <span style="width: 10px; height: 10px; border-radius: 50%; background: #28c840;"></span>
          </div>
          <span style="font-size: .68rem; color: var(--text-dim); font-family: 'JetBrains Mono', monospace;">zsh — share-env</span>
        </div>
        <div style="padding: 20px 24px; font-family: 'JetBrains Mono', monospace; font-size: .82rem; line-height: 1.8;">
          <div style="color: var(--text-muted);"><span style="color: var(--accent);">$</span> npx share-env status</div>
          <div style="color: var(--warn); margin-top: 4px;">✖ Error: 500 Internal Server Error — Server is temporarily unavailable</div>
          <div style="color: var(--ok); margin-top: 4px;">✔ Security check: Local .env was NOT modified</div>
          <div style="color: var(--ok);">✔ Privacy check: Decryption key never transmitted</div>
          <div style="color: var(--text-dim); margin-top: 8px;">// Tip: The zero-knowledge relay will auto-recover shortly</div>
        </div>
      </div>

      <!-- Action Buttons -->
      <div style="display: flex; gap: 14px; justify-content: center; flex-wrap: wrap; margin-bottom: 56px;">
        <button class="btn btn-p" onclick="window.location.reload()">
          <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M21.5 2v6h-6M21.34 15.57a10 10 0 1 1-.57-8.38l5.67-5.67"/></svg>
          Reload Page
        </button>
        <a class="btn btn-s" href="/">
          <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m3 9 9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"/><polyline points="9 22 9 12 15 12 15 22"/></svg>
          Back to Home
        </a>
        <a class="btn btn-s" href="https://github.com/arjunn881/env-share/issues" target="_blank" rel="noopener">
          <svg width="15" height="15" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12 0C5.374 0 0 5.373 0 12c0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23A11.509 11.509 0 0112 5.803c1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576C20.566 21.797 24 17.3 24 12c0-6.627-5.373-12-12-12z"/></svg>
          Report on GitHub
        </a>
      </div>

      <!-- Self host tip -->
      <div style="text-align: left; background: var(--bg-card); border: 1px solid var(--border); border-radius: var(--r-lg); padding: 24px 28px; backdrop-filter: blur(14px);">
        <div style="display: flex; gap: 14px; align-items: flex-start;">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="var(--accent)" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="flex-shrink: 0; margin-top: 2px;" aria-hidden="true"><circle cx="12" cy="12" r="10"/><line x1="12" y1="16" x2="12" y2="12"/><line x1="12" y1="8" x2="12.01" y2="8"/></svg>
          <div>
            <div style="font-weight: 700; font-size: .92rem; color: var(--text); margin-bottom: 4px;">Need 100% Guaranteed Uptime?</div>
            <p style="font-size: .83rem; color: var(--text-muted); line-height: 1.6; margin-bottom: 8px;">
              You can self-host the share-env relay on your own infrastructure (Render, Railway, Fly.io, or VPS) with zero external dependencies.
            </p>
            <a href="/self-host" style="font-size: .82rem; font-weight: 600; color: var(--accent); font-family: 'JetBrains Mono', monospace;">See Self-Hosting Guide →</a>
          </div>
        </div>
      </div>

    </div>

  </div>
</Base>
