---
import Base from '../layouts/Base.astro';
---

<Base
  title="Contact — share-env"
  description="Get in touch with the share-env team. Report issues, ask questions, or contribute to the open-source project."
>
  <div class="container">
    <div class="page-hero">
      <p class="sl">Contact</p>
      <h1>Get in touch.</h1>
      <p class="desc">Have a question, found a bug, or want to contribute? Here is how to reach us.</p>
    </div>

    <div style="max-width:820px;display:grid;grid-template-columns:1fr 1fr;gap:24px;" class="contact-grid">

      <!-- GitHub Issues -->
      <a href="https://github.com/arjunn881/env-share/issues" target="_blank" rel="noopener noreferrer" class="contact-card rv">
        <div class="cc-icon" style="background:rgba(167,139,250,0.1);border-color:rgba(167,139,250,0.2);">
          <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="var(--accent-3)" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <circle cx="12" cy="12" r="10"/>
            <line x1="12" y1="8" x2="12" y2="12"/>
            <line x1="12" y1="16" x2="12.01" y2="16"/>
          </svg>
        </div>
        <div class="cc-title">Report a Bug</div>
        <div class="cc-desc">Found something broken? Open an issue on GitHub with steps to reproduce. We respond to bugs quickly.</div>
        <div class="cc-link">github.com/arjunn881/env-share/issues &rarr;</div>
      </a>

      <!-- GitHub Discussions -->
      <a href="https://github.com/arjunn881/env-share/discussions" target="_blank" rel="noopener noreferrer" class="contact-card rv d1">
        <div class="cc-icon" style="background:rgba(0,212,255,0.08);border-color:rgba(0,212,255,0.2);">
          <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="var(--accent-2)" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M21 15a2 2 0 01-2 2H7l-4 4V5a2 2 0 012-2h14a2 2 0 012 2z"/>
          </svg>
        </div>
        <div class="cc-title">Ask a Question</div>
        <div class="cc-desc">Have a usage question or need help with self-hosting? GitHub Discussions is the best place to ask.</div>
        <div class="cc-link">github.com/arjunn881/env-share/discussions &rarr;</div>
      </a>

      <!-- Feature Request -->
      <a href="https://github.com/arjunn881/env-share/issues/new?labels=enhancement" target="_blank" rel="noopener noreferrer" class="contact-card rv d2">
        <div class="cc-icon" style="background:rgba(61,255,176,0.08);border-color:rgba(61,255,176,0.2);">
          <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="var(--accent)" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"/>
          </svg>
        </div>
        <div class="cc-title">Request a Feature</div>
        <div class="cc-desc">Have an idea that would make share-env better? Submit a feature request on GitHub with your use case.</div>
        <div class="cc-link">Open feature request &rarr;</div>
      </a>

      <!-- Security -->
      <a href="https://github.com/arjunn881/env-share/security" target="_blank" rel="noopener noreferrer" class="contact-card rv d3">
        <div class="cc-icon" style="background:rgba(255,77,109,0.08);border-color:rgba(255,77,109,0.2);">
          <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="var(--danger)" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/>
          </svg>
        </div>
        <div class="cc-title">Report a Security Issue</div>
        <div class="cc-desc">Found a security vulnerability? Please use GitHub's private security reporting — do not open a public issue.</div>
        <div class="cc-link">Private security report &rarr;</div>
      </a>

    </div>

    <!-- Alternative: npm -->
    <div style="max-width:820px;margin-top:32px;" class="rv d4">
      <div class="info-box tip">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><line x1="12" y1="8" x2="12" y2="12"/><line x1="12" y1="16" x2="12.01" y2="16"/></svg>
        <span>
          For questions about npm package publishing, see the
          <a href="https://www.npmjs.com/package/share-env" target="_blank" rel="noopener noreferrer">npm package page</a>.
          For privacy or legal inquiries, reference our <a href="/privacy">Privacy Policy</a> and <a href="/terms">Terms of Service</a>.
        </span>
      </div>
    </div>

    <!-- Contributing -->
    <div style="max-width:820px;margin-top:32px;background:var(--bg-card);border:1px solid var(--border-m);border-radius:var(--r-xl);padding:36px 40px;backdrop-filter:blur(14px);" class="rv">
      <h2 style="font-size:1.1rem;font-weight:800;letter-spacing:-.4px;margin-bottom:14px;">Contributing</h2>
      <p style="font-size:.88rem;color:var(--text-muted);line-height:1.72;margin-bottom:18px;">
        <code>share-env</code> is open-source and welcomes contributions. The repository is a TypeScript monorepo with two workspaces: <code>cli</code> (the command-line tool) and <code>server</code> (the relay server).
      </p>
      <div class="cblock">
        <div class="cblock-head"><span class="cblock-lang">bash — contribute</span><button class="cbtn" onclick="cb(this,'git clone https://github.com/arjunn881/env-share.git\ncd env-share\nnpm install\nnpm run build')"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" width="11" height="11"><rect x="9" y="9" width="13" height="13" rx="2" ry="2"/><path d="M5 15H4a2 2 0 01-2-2V4a2 2 0 012-2h9a2 2 0 012 2v1"/></svg>Copy</button></div>
        <pre class="ccode"><span class="cp">$</span> git clone https://github.com/arjunn881/env-share.git
<span class="cp">$</span> cd env-share
<span class="cp">$</span> npm install
<span class="cp">$</span> npm run build</pre>
      </div>
    </div>

  </div>

  <style>
    .contact-card {
      display: flex; flex-direction: column; gap: 12px;
      background: var(--bg-card); border: 1px solid var(--border);
      border-radius: var(--r-lg); padding: 28px 24px;
      backdrop-filter: blur(14px); transition: all .3s;
      text-decoration: none; color: inherit;
    }
    .contact-card:hover { border-color: var(--border-m); transform: translateY(-3px); box-shadow: 0 20px 50px rgba(0,0,0,.4); }
    .cc-icon { width: 48px; height: 48px; border-radius: 12px; border: 1px solid; display: flex; align-items: center; justify-content: center; }
    .cc-title { font-weight: 700; font-size: .95rem; }
    .cc-desc { font-size: .845rem; color: var(--text-muted); line-height: 1.6; flex: 1; }
    .cc-link { font-size: .78rem; color: var(--accent); font-family: 'JetBrains Mono', monospace; }
    @media(max-width:640px){ .contact-grid { grid-template-columns: 1fr !important; } }
  </style>
</Base>
