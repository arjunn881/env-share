---
import Base from '../layouts/Base.astro';
import AdSlot from '../components/AdSlot.astro';
---

<Base
  title="How share-env Works — Zero-Knowledge .env Sharing"
  description="Learn how share-env uses AES-256-GCM encryption, a blind relay server, and burn-after-reading to securely share .env files between developers."
>
  <div class="container">
    <div class="page-hero">
      <p class="sl">How it works</p>
      <h1>Zero-knowledge relay in three steps.</h1>
      <p class="desc">The decryption key travels exclusively inside the share code — the relay server is completely blind to it.</p>
    </div>

    <!-- FLOW -->
    <section style="padding-top:0;">
      <div style="display:grid;grid-template-columns:1fr 40px 1fr 40px 1fr;gap:0;align-items:start;" class="flow-g rv">
        <!-- Sender -->
        <div style="background:var(--bg-card);border:1px solid rgba(61,255,176,.2);border-radius:20px;padding:28px 22px;backdrop-filter:blur(14px);">
          <div style="width:48px;height:48px;border-radius:12px;background:rgba(61,255,176,.08);border:1px solid rgba(61,255,176,0.2);display:flex;align-items:center;justify-content:center;margin:0 auto 14px;">
            <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="var(--accent)" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="11" width="18" height="11" rx="2"/><path d="M7 11V7a5 5 0 0110 0v4"/></svg>
          </div>
          <div style="text-align:center;font-weight:700;font-size:.88rem;margin-bottom:14px;">Developer A — Sender</div>
          <ul style="list-style:none;display:flex;flex-direction:column;gap:7px;">
            {['Generate random 256-bit key in local memory','Generate random 96-bit IV','Encrypt .env with AES-256-GCM','POST ciphertext + IV + auth tag to relay','Build share code: phrase#hexKey','Send code via Slack / Teams / Signal'].map((s,i) => (
              <li style="font-size:.75rem;color:var(--text-muted);display:flex;gap:7px;align-items:flex-start;line-height:1.5;">
                <span style="min-width:16px;height:16px;border-radius:4px;background:rgba(61,255,176,.15);color:var(--accent);font-size:.62rem;font-weight:800;display:flex;align-items:center;justify-content:center;flex-shrink:0;margin-top:1px;">{i+1}</span>
                {s}
              </li>
            ))}
          </ul>
        </div>
        <!-- Arrow -->
        <div style="display:flex;flex-direction:column;align-items:center;justify-content:center;padding-top:60px;gap:5px;">
          <span style="font-size:.58rem;font-family:'JetBrains Mono',monospace;color:var(--text-dim);white-space:nowrap;text-align:center;">ciphertext<br>only</span>
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="rgba(61,255,176,0.35)" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="9 18 15 12 9 6"/></svg>
        </div>
        <!-- Relay -->
        <div style="background:var(--bg-card);border:1px solid rgba(0,212,255,.2);border-radius:20px;padding:28px 22px;backdrop-filter:blur(14px);">
          <div style="width:48px;height:48px;border-radius:12px;background:rgba(0,212,255,.08);border:1px solid rgba(0,212,255,0.2);display:flex;align-items:center;justify-content:center;margin:0 auto 14px;">
            <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="var(--accent-2)" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="2" y="3" width="20" height="14" rx="2"/><line x1="8" y1="21" x2="16" y2="21"/><line x1="12" y1="17" x2="12" y2="21"/></svg>
          </div>
          <div style="text-align:center;font-weight:700;font-size:.88rem;margin-bottom:14px;">Relay Server (blind)</div>
          <ul style="list-style:none;display:flex;flex-direction:column;gap:7px;">
            {['Receives & stores ciphertext only','Returns 3-word phrase identifier','On GET: returns encrypted payload once...','...then permanently deletes it','Auto-expires payloads after 10m TTL','Rate limit: 10 req/min per IP'].map((s,i) => (
              <li style="font-size:.75rem;color:var(--text-muted);display:flex;gap:7px;align-items:flex-start;line-height:1.5;">
                <span style="min-width:16px;height:16px;border-radius:4px;background:rgba(0,212,255,.15);color:var(--accent-2);font-size:.62rem;font-weight:800;display:flex;align-items:center;justify-content:center;flex-shrink:0;margin-top:1px;">{String.fromCharCode(65+i)}</span>
                {s}
              </li>
            ))}
          </ul>
        </div>
        <!-- Arrow -->
        <div style="display:flex;flex-direction:column;align-items:center;justify-content:center;padding-top:60px;gap:5px;">
          <span style="font-size:.58rem;font-family:'JetBrains Mono',monospace;color:var(--text-dim);white-space:nowrap;text-align:center;">encrypted<br>payload</span>
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="rgba(61,255,176,0.35)" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="9 18 15 12 9 6"/></svg>
        </div>
        <!-- Receiver -->
        <div style="background:var(--bg-card);border:1px solid rgba(167,139,250,.2);border-radius:20px;padding:28px 22px;backdrop-filter:blur(14px);">
          <div style="width:48px;height:48px;border-radius:12px;background:rgba(167,139,250,.08);border:1px solid rgba(167,139,250,0.2);display:flex;align-items:center;justify-content:center;margin:0 auto 14px;">
            <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="var(--accent-3)" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M20 21v-2a4 4 0 00-4-4H8a4 4 0 00-4 4v2"/><circle cx="12" cy="7" r="4"/></svg>
          </div>
          <div style="text-align:center;font-weight:700;font-size:.88rem;margin-bottom:14px;">Developer B — Receiver</div>
          <ul style="list-style:none;display:flex;flex-direction:column;gap:7px;">
            {['Run npx share-env pull <code>','Parse share code: phrase + key','GET relay using phrase only (no key)','Decrypt locally using extracted key','Smart-merge into existing .env','Write merged result to disk'].map((s,i) => (
              <li style="font-size:.75rem;color:var(--text-muted);display:flex;gap:7px;align-items:flex-start;line-height:1.5;">
                <span style="min-width:16px;height:16px;border-radius:4px;background:rgba(167,139,250,.15);color:var(--accent-3);font-size:.62rem;font-weight:800;display:flex;align-items:center;justify-content:center;flex-shrink:0;margin-top:1px;">{i+7}</span>
                {s}
              </li>
            ))}
          </ul>
        </div>
      </div>
    </section>

    <AdSlot slot={undefined} />

    <!-- FEATURES -->
    <section>
      <div class="sh">
        <p class="sl rv">Features</p>
        <h2 class="st rv d1">Built with security non-negotiable.</h2>
      </div>
      <div style="display:grid;grid-template-columns:repeat(3,1fr);gap:18px;" class="feat-g">
        {[
          {title:'Zero-Knowledge Encryption',desc:'AES-256-GCM key is generated locally and never transmitted. A fully compromised relay yields only unreadable ciphertext.',color:'var(--accent)'},
          {title:'Burn-After-Reading',desc:'Payload is permanently deleted from the relay the moment it is pulled. It cannot be retrieved a second time by anyone.',color:'var(--danger)'},
          {title:'Smart Merge',desc:'Detects conflicts key-by-key when you already have a .env and lets you interactively choose local or remote values.',color:'var(--accent-2)'},
          {title:'Git Guardrails',desc:'Refuses to run unless your .gitignore explicitly ignores .env and .env.* — blocking accidental secret commits.',color:'var(--warn)'},
          {title:'Zero Setup',desc:'No global install, no accounts, no config files. Run via npx share-env. Requires only Node.js 18+.',color:'var(--accent-3)'},
          {title:'10-Minute TTL',desc:'Share codes expire after 10 minutes. Uncollected payloads are permanently purged — nothing lingers.',color:'var(--ok)'},
        ].map(f => (
          <div style={`background:var(--bg-card);border:1px solid var(--border);border-radius:20px;padding:28px 24px;backdrop-filter:blur(14px);transition:all .3s;`} class="rv hover-card">
            <div style="font-weight:700;font-size:.93rem;margin-bottom:8px;">{f.title}</div>
            <div style="font-size:.845rem;color:var(--text-muted);line-height:1.65;">{f.desc}</div>
          </div>
        ))}
      </div>
    </section>
  </div>

  <style>
    .hover-card:hover{border-color:var(--border-m);transform:translateY(-3px);box-shadow:0 20px 50px rgba(0,0,0,.4);}
    @media(max-width:960px){.flow-g{grid-template-columns:1fr!important;gap:12px!important} .flow-g>*:nth-child(even){display:none} .feat-g{grid-template-columns:1fr 1fr!important}}
    @media(max-width:640px){.feat-g{grid-template-columns:1fr!important}}
  </style>
</Base>
