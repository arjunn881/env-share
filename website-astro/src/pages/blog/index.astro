---
import Base from '../../layouts/Base.astro';
import AdSlot from '../../components/AdSlot.astro';

const posts = [
  {
    slug: 'dotenv-security-best-practices',
    title: '9 .env Security Best Practices Every Developer Should Know',
    desc: 'How to handle .env files safely: gitignore rules, encryption, secret rotation, and why sharing via chat is dangerous.',
    date: '2024-12-01',
    readTime: '6 min read',
    tags: ['Security', '.env', 'Best Practices'],
  },
  {
    slug: 'aes-256-gcm-explained',
    title: 'AES-256-GCM Explained for Developers',
    desc: 'A developer-friendly breakdown of AES-256-GCM encryption: keys, IVs, authentication tags, and why it is the right choice for .env sharing.',
    date: '2024-12-08',
    readTime: '5 min read',
    tags: ['Cryptography', 'Security', 'Node.js'],
  },
  {
    slug: 'how-to-share-env-files-safely',
    title: 'How to Share .env Files Safely with Your Team',
    desc: 'A practical guide to sharing environment secrets without exposing them in chat, email, or git history. Includes a comparison of available tools.',
    date: '2024-12-15',
    readTime: '7 min read',
    tags: ['Workflow', 'Team', 'DevOps'],
  },
];
---

<Base
  title="Blog — .env Security, Encryption, and Developer Workflows"
  description="Articles on .env file security, AES-256-GCM encryption for developers, team secret sharing best practices, and Node.js security patterns."
>
  <div class="container">
    <div class="page-hero">
      <p class="sl">Blog</p>
      <h1>Security insights for developers.</h1>
      <p class="desc">In-depth articles on .env file security, encryption patterns, and safe team workflows.</p>
    </div>

    <div style="display:grid;grid-template-columns:repeat(3,1fr);gap:20px;margin-bottom:48px;" class="post-grid">
      {posts.map((post, i) => (
        <a href={`/blog/${post.slug}`} style="background:var(--bg-card);border:1px solid var(--border);border-radius:20px;padding:28px 24px;backdrop-filter:blur(14px);transition:all .3s;display:flex;flex-direction:column;gap:14px;text-decoration:none;color:inherit;" class={`rv hover-card${i > 0 ? ` d${i}` : ''}`}>
          <div style="display:flex;flex-wrap:wrap;gap:6px;">
            {post.tags.map(tag => (
              <span style="background:rgba(61,255,176,.06);border:1px solid var(--border);color:var(--accent);font-size:.62rem;font-weight:700;padding:2px 8px;border-radius:100px;letter-spacing:.5px;text-transform:uppercase;">{tag}</span>
            ))}
          </div>
          <h2 style="font-size:.95rem;font-weight:700;line-height:1.45;letter-spacing:-.3px;">{post.title}</h2>
          <p style="font-size:.82rem;color:var(--text-muted);line-height:1.6;flex:1;">{post.desc}</p>
          <div style="display:flex;align-items:center;gap:12px;font-size:.73rem;color:var(--text-dim);">
            <time datetime={post.date}>{new Date(post.date).toLocaleDateString('en-US',{month:'long',day:'numeric',year:'numeric'})}</time>
            <span>&middot;</span>
            <span>{post.readTime}</span>
          </div>
        </a>
      ))}
    </div>

    <AdSlot slot={undefined} />
  </div>

  <style>
    .hover-card:hover{border-color:var(--border-m);transform:translateY(-3px);box-shadow:0 20px 50px rgba(0,0,0,.4);}
    @media(max-width:960px){.post-grid{grid-template-columns:1fr 1fr!important}}
    @media(max-width:600px){.post-grid{grid-template-columns:1fr!important}}
  </style>
</Base>
