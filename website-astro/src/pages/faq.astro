        </div>

        <div class="faq-accordion rv" itemscope itemtype="https://schema.org/FAQPage">
          {group.items.map((faq, fi) => (
            <div
              class={`acc-item${fi === 0 ? ' open' : ''}`}
              itemscope
              itemprop="mainEntity"
              itemtype="https://schema.org/Question"
            >
              <div
                class="acc-head"
                onclick="toggleAcc(this)"
