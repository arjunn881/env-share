                aria-expanded={fi === 0 ? 'true' : 'false'}
                onkeydown="if(event.key==='Enter'||event.key===' '){event.preventDefault();toggleAcc(this);}"
              >
                <span class="acc-q-num" aria-hidden="true">{gi + 1}.{fi + 1}</span>
                <span class="acc-q-text" itemprop="name">{faq.q}</span>
                <span class="acc-chev" aria-hidden="true">
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" width="16" height="16"><polyline points="6 9 12 15 18 9"/></svg>
